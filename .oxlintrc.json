{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist", "node_modules", "prototype", "research"],
  "rules": {
    // The CLI's whole output surface is stdout.
    "no-console": "off",
    "typescript/no-explicit-any": "warn",
    // Obsolete under the automatic JSX runtime (react-jsx), which this project
    // uses — there is no `React` identifier to have in scope.
    "react/react-in-jsx-scope": "off",
    // `_tag` is Effect's discriminant, not a private-field convention. It is
    // spelled that way by `Data.TaggedError`, `Schema.TaggedError` and every
    // `Option`/`Either` in the codebase; there is nothing to rename.
    "no-underscore-dangle": "off"
  }
}
