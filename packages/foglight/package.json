{
  "name": "foglight",
  "version": "0.1.0",
  "description": "A read-only viewer for wayfinder maps: renders a map as a live dependency graph, in a desktop window or headless in your browser.",
  "keywords": [
    "dependency-graph",
    "map",
    "planning",
    "viewer",
    "wayfinder"
  ],
  "license": "MIT",
  "bin": {
    "foglight": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown && node ./scripts/copy-client.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "electron": "^43.3.0"
  },
  "devDependencies": {
    "@effect/experimental": "0.61.1",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@foglight/client": "workspace:*",
    "@foglight/core": "workspace:*",
    "@foglight/electron": "workspace:*",
    "@foglight/server": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.5",
    "effect": "3.22.1",
    "qrcode": "^1.5.4",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
